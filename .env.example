# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# الدفع الإلكتروني (انظر PAYMENTS.md)
# في التطوير: PAYMENT_PROVIDER=sandbox (افتراضي) — لا يُخصم أي مبلغ.
# في الإنتاج: لا يوجد افتراضي. بدون مزوّد مضبوط يُرفض أي دفع ولا يُفعَّل أي اشتراك.
# ---------------------------------------------------------------------------
# PAYMENT_PROVIDER=hosted
# PAYMENT_API_URL=https://gateway.example.com/v1/orders
# PAYMENT_API_KEY=sk_live_xxx
# PAYMENT_WEBHOOK_SECRET=whsec_xxx
# PAYMENT_SIGNATURE_HEADER=x-signature      # اسم ترويسة التوقيع لدى بوابتك
# PAYMENT_SIGNATURE_ENCODING=hex            # hex | base64
# PAYMENT_AMOUNT_UNIT=major                 # major = جنيه | minor = قرش
# PAYMENT_METHODS=card,wallet,instapay,fawry
# ALLOWED_ORIGINS=https://app.example.com   # أصول إضافية مسموحة لطلبات POST
